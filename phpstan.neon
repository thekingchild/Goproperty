includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tools/
        - tests/Fixtures/Models/
        # Every module's code (ARCHITECTURE.md § 8); module tests are not
        # analysed, like tests/.
        - Modules/

    excludePaths:
        analyse:
            - Modules/*/tests/*

    level: 7

rules:
    # Tenancy guard: only the Platform namespace may remove OrganizationScope.
    - Tools\PHPStan\Rules\OrganizationScopeBypassRule
