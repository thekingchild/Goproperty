{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "goproperty/goproperty",
    "type": "project",
    "description": "GoProperty: multi-tenant property management SaaS.",
    "keywords": [
        "property-management",
        "saas",
        "laravel"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4.1",
        "dompdf/dompdf": "~3.1.6",
        "filament/filament": "~5.10.3",
        "laravel/fortify": "~1.41.0",
        "laravel/framework": "~13.38.0",
        "laravel/tinker": "~3.0.2",
        "league/flysystem-aws-s3-v3": "^3.35",
        "livewire/blaze": "~1.0.20",
        "livewire/flux": "~2.21.0",
        "livewire/livewire": "~4.4.8",
        "nwidart/laravel-modules": "~13.2.0",
        "spatie/laravel-activitylog": "~5.1.3",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-medialibrary": "~11.23.11",
        "spatie/laravel-permission": "~8.3.2"
    },
    "require-dev": {
        "fakerphp/faker": "~1.24.1",
        "larastan/larastan": "~3.13.2",
        "laravel/pail": "~1.2.7",
        "laravel/pao": "~1.1.5",
        "laravel/pint": "~1.32.1",
        "laravel/sail": "~1.69.0",
        "mockery/mockery": "~1.6.15",
        "nunomaduro/collision": "~8.9.5",
        "pestphp/pest": "~4.7.8",
        "pestphp/pest-plugin-laravel": "~4.1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tools\\PHPStan\\": "tools/phpstan/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test --parallel"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "pre-autoload-dump": [
            "Aws\\Script\\Composer\\Composer::removeUnusedServices"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        },
        "aws/aws-sdk-php": [
            "S3"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        },
        "platform": {
            "php": "8.4.1"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
