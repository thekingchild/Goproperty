APP_NAME=GoProperty
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 or MariaDB 10.6+ (see ARCHITECTURE.md § 2). Defaults match Laravel Sail.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=goproperty
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# Hosting profile (ARCHITECTURE.md § 12.1): "shared" (cPanel/Plesk) or "vps".
# It sets the queue, cache, session, broadcast, realtime and PDF defaults.
# Uncomment a line below only to override one of them.
HOSTING_PROFILE=shared
# QUEUE_CONNECTION=database
# CACHE_STORE=database
# SESSION_DRIVER=database
# BROADCAST_CONNECTION=null
# REALTIME_DRIVER=polling
# PDF_DRIVER=dompdf
# PDF_CHROME_URL=http://127.0.0.1:3000
# QUEUE_TICK_ENABLED=true

# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups (PLATFORM_CONSOLE.md § 4, docs/runbooks/restore.md). Destinations
# are set in the console or with goproperty:backup-destination, not here.
# php: dump in PHP, no exec needed (shared hosting); mysqldump: use the binary.
BACKUP_DUMPER=php
# An empty database the monthly verify may wipe and restore into.
BACKUP_VERIFY_DB_DATABASE=
# The backup zips' password. Empty: derived from APP_KEY.
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
