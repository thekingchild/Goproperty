APP_NAME=GoProperty
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 or MariaDB 10.6+ (see ARCHITECTURE.md § 2). Defaults match Laravel Sail.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=goproperty
DB_USERNAME=sail
DB_PASSWORD=password
# Read replica for the dashboards' report queries (VPS only; ARCHITECTURE.md § 13
# "How it is built (P08-04)"). Unset: they read the main database. Port, user and
# password fall back to the DB_* above; writes always go to the main database.
# DB_REPORTS_HOST=
# DB_REPORTS_PORT=
# DB_REPORTS_USERNAME=
# DB_REPORTS_PASSWORD=
# DB_REPORTS_PRIMARY_AFTER_WRITE=60   # seconds after an organization's last write its reports read the main database

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# Hosting profile (ARCHITECTURE.md § 12.1): "shared" (cPanel/Plesk) or "vps".
# It sets the queue, cache, session, broadcast, realtime and PDF defaults.
# Uncomment a line below only to override one of them.
HOSTING_PROFILE=shared
# QUEUE_CONNECTION=database
# CACHE_STORE=database
# SESSION_DRIVER=database
# BROADCAST_CONNECTION=null
# REALTIME_DRIVER=polling
# PDF_DRIVER=dompdf
# PDF_CHROME_URL=http://127.0.0.1:3000   # Gotenberg; http://gotenberg:3000 under Sail (compose.yaml), also used by the document visual-diff tests
# QUEUE_TICK_ENABLED=true
# REALTIME_POLL_SECONDS=15            # live pages' poll; 60 s behind Reverb (REALTIME_FALLBACK_POLL_SECONDS)

# Reverb (VPS only: docs/runbooks/vps-realtime.md). The app reaches Reverb at
# REVERB_HOST:REVERB_PORT; browsers at REVERB_CLIENT_* when that differs.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_CLIENT_HOST=ws.example.com
# REVERB_CLIENT_PORT=443
# REVERB_CLIENT_SCHEME=https

# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Bounce and complaint webhook: /webhooks/email/{postmark|mailgun}/{MAIL_WEBHOOK_TOKEN} (24+ random characters)
MAIL_WEBHOOK_TOKEN=
MAILGUN_WEBHOOK_SIGNING_KEY=

# SMS (GoText, GoProperty's own account). Real messages go only in production with SMS_DRIVER=gotext.
SMS_DRIVER=log
GOTEXT_API_TOKEN=
GOTEXT_SENDER_ID=GoProperty
GOTEXT_BASE_URL=https://app.gotext.ng

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Transaction Tier documents (config/compliance.php): their own private disk.
# compliance = storage/app/compliance; compliance-s3 = its own bucket below.
COMPLIANCE_DISK=compliance
COMPLIANCE_S3_ACCESS_KEY_ID=
COMPLIANCE_S3_SECRET_ACCESS_KEY=
COMPLIANCE_S3_REGION=us-east-1
COMPLIANCE_S3_BUCKET=
COMPLIANCE_S3_ENDPOINT=

# Media library (config/media.php, config/media-library.php): photos, payment
# proofs, branding images. media = storage/app/media (the default); media-s3 =
# a private bucket. Change it with `php artisan goproperty:media-move`, which
# moves the files already uploaded too. media-s3 uses the AWS_* bucket above
# under MEDIA_S3_ROOT unless MEDIA_S3_* names another one.
# MEDIA_DISK=media
# MEDIA_S3_BUCKET=
# MEDIA_S3_ROOT=media
# Signed links to files expire after this many minutes.
# MEDIA_URL_LIFETIME=15
# Largest photo accepted; lower it where PHP's memory_limit is under 256M.
# MEDIA_MAX_MEGAPIXELS=25
# gd (every host) or imagick.
# MEDIA_IMAGE_DRIVER=gd

# GoProperty's own Paystack account (config/services.php). Also used to check
# the names of organizations' bank accounts; empty = names are not checked.
PAYSTACK_SECRET_KEY=

# Organizations' own WhatsApp (ARCHITECTURE.md § 6.7). cloud: Meta's Cloud API
# through each organization's own connection (Settings → WhatsApp; Meta is
# called only in production, a log stand-in elsewhere); log: a stand-in that
# sends nothing and is never offered in production; none: off.
# WHATSAPP_DRIVER=cloud
# WHATSAPP_GRAPH_VERSION=v21.0

# Backups (PLATFORM_CONSOLE.md § 4, docs/runbooks/restore.md). Destinations
# are set in the console or with goproperty:backup-destination, not here.
# php: dump in PHP, no exec needed (shared hosting); mysqldump: use the binary.
BACKUP_DUMPER=php
# An empty database the monthly verify may wipe and restore into.
BACKUP_VERIFY_DB_DATABASE=
# The staging site's database, which the console's "Restore to staging" replaces.
BACKUP_STAGING_DB_DATABASE=
# The backup zips' password. Empty: derived from APP_KEY.
BACKUP_ARCHIVE_PASSWORD=

# Upgrades (INSTALLER.md § 10, docs/runbooks/upgrade.md). Console → Operations →
# Version shows this GitHub repository's latest published release (asked in
# production and staging only; nothing is downloaded).
# GOPROPERTY_RELEASES_REPOSITORY=thekingchild/Goproperty

VITE_APP_NAME="${APP_NAME}"
